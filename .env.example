# Copy to .env and fill in values. See .env for setup notes.

# Supabase Postgres (Project Settings > Database > Connect > Session pooler).
# Use the Session pooler string, NOT "Direct connection" — the direct
# connection host (db.[PROJECT-REF].supabase.co:5432) only has an IPv6
# address, so it's unreachable from networks without working IPv6 (this has
# hit multiple developers on this project; see PR #56/#75 for the debugging
# story). The pooler host (aws-0-<region>.pooler.supabase.com:6543) resolves
# to IPv4 and works everywhere.
# `pgbouncer=true` is required for the pooler (transaction-mode connections
# don't support prepared statements the same way a direct connection does).
# `uselibpqcompat=true` restores encrypt-without-verify behavior for
# `sslmode=require` (needed because pg's newer default treats `require` as
# `verify-full`, which rejects Supabase's cert chain).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"

# Alternative for local-only dev without touching Supabase:
# run `npx prisma dev --detach` and use the TCP URL it prints, e.g.
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Supabase project API settings (Project Settings > API).
# Used only for Auth / Storage / Realtime — never for table reads/writes
# (those go through Prisma). See docs/アーキテクチャ.md.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-PUBLIC-KEY]"
