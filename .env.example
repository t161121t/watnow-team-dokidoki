# Copy to .env and fill in values. See .env for setup notes.

# Supabase Postgres (Project Settings > Database > Connection string).
# `uselibpqcompat=true` restores encrypt-without-verify behavior for
# `sslmode=require` (needed because pg's newer default treats `require` as
# `verify-full`, which rejects Supabase's cert chain).
DATABASE_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"

# Alternative for local-only dev without touching Supabase:
# run `npx prisma dev --detach` and use the TCP URL it prints, e.g.
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Supabase project API settings (Project Settings > API).
# Used only for Auth / Storage / Realtime — never for table reads/writes
# (those go through Prisma). See docs/アーキテクチャ.md.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-PUBLIC-KEY]"
