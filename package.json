{
  "name": "watnow-team-dokidoki",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:dev": "prisma dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/check-db.ts",
    "db:sql": "tsx scripts/apply-sql.ts",
    "db:setup": "prisma migrate deploy && npm run db:sql",
    "verify:auth": "tsx scripts/verify-auth.mts",
    "verify:storage": "tsx scripts/verify-storage.mts",
    "verify:groups": "tsx scripts/verify-groups.mts",
    "verify:secrets": "tsx scripts/verify-secrets.mts",
    "verify:auctions": "tsx scripts/verify-auctions.mts",
    "verify:challenges": "tsx --conditions=react-server scripts/verify-challenges.mts",
    "verify:wallet": "tsx --conditions=react-server scripts/verify-wallet.mts",
    "verify:rls": "tsx scripts/verify-rls.mts",
    "verify:auction": "tsx scripts/verify-auction-flow.mts",
    "setup": "npm install && npm run db:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
