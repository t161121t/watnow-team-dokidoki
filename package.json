{
  "name": "watnow-team-dokidoki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "env:check": "node scripts/check-environment.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:development": "tsc -b && vite build --mode development",
    "preview": "vite preview",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "edge:fmt": "deno task --config supabase/deno.json fmt",
    "verify:web": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "verify:edge": "deno task --config supabase/deno.json verify",
    "verify:db": "node scripts/run-supabase.mjs test db",
    "verify": "pnpm verify:web && pnpm verify:edge && pnpm verify:db",
    "ui:add": "pnpm dlx shadcn@4.18.0 add",
    "ui:info": "pnpm dlx shadcn@4.18.0 info",
    "supabase:start": "node scripts/run-supabase.mjs start",
    "supabase:stop": "node scripts/run-supabase.mjs stop",
    "supabase:status": "node scripts/run-supabase.mjs status",
    "supabase:reset": "node scripts/run-supabase.mjs db reset",
    "supabase:types": "node scripts/generate-database-types.mjs",
    "cf:dev": "pnpm build:development && wrangler dev",
    "cf:deploy": "node scripts/check-production-env.mjs && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hookform/resolvers": "5.8.0",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.30",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "lefthook": "2.1.10",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-build": "7.4.1",
    "wrangler": "4.123.0"
  }
}
